{
  "required": [
    "name",
    "storeType"
  ],
  "type": "object",
  "properties": {
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "price": {
      "type": "number",
      "format": "double"
    },
    "description": {
      "maxLength": 2000,
      "type": "string",
      "nullable": true
    },
    "imageUrl": {
      "maxLength": 500,
      "type": "string",
      "nullable": true
    },
    "storeType": {
      "minLength": 1,
      "type": "string"
    },
    "subCategory": {
      "maxLength": 100,
      "type": "string",
      "nullable": true
    },
    "attributes": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/ProductAttributeDto"
      },
      "nullable": true
    }
  },
  "additionalProperties": false
}